<article class="boardgame boardgame--{{ variant }}" data-game-title="{{ boardgame.title|lower|e('html_attr') }}">
    <a class="boardgame__link" href="{{ boardgame.getBggUrl() }}" target="_blank" rel="noopener noreferrer" aria-label="{{ boardgame.title }} on BoardGameGeek">
        <div class="boardgame__media">
    {% if boardgame.thumbnailUrl %}
            <img class="boardgame-image"
                 src="{{ boardgame.thumbnailUrl }}"
                 alt="{{ boardgame.title }}"
                 title="{{ boardgame.title }}"
                 loading="lazy"
            />
    {% else %}
        <div class="boardgame-image-placeholder">
            <span>{{ boardgame.title }}</span>
        </div>
    {% endif %}
        </div>
        <div class="boardgame__body">
            <strong>{{ boardgame.title }}</strong>
            {% if variant != 'plays' %}<span>BGG #{{ boardgame.bggId }}</span>{% endif %}
        </div>
    </a>
</article>
